# 复制到 searxng/core-config/settings.yml 后执行: cd searxng && docker compose restart
# Read the documentation before extending the defaults:
# https://docs.searxng.org/admin/settings/

use_default_settings: true

search:
  formats:
    - html
    - json

server:
  secret_key: "WaHqeaZIguEoia9Vf6oclbNDLHKpYFCb"
  image_proxy: true

engines:
  - name: google
    disabled: true
  - name: duckduckgo
    disabled: true
  - name: brave
    disabled: true
  - name: startpage
    disabled: true
  - name: wikipedia
    disabled: true
