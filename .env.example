# Agnes API (OpenAI 兼容)
OPENAI_API_KEY="sk-your-key-here"
OPENAI_API_BASE="https://apihub.agnes-ai.com/v1"

# 其他服务商(备用)
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# BRAVE_API_KEY=

# Exa Search API (SEARCH_BACKEND=exa 时使用)
# EXA_API_KEY=

# Serper — Google 搜索 API，site: 语法稳定 (SEARCH_BACKEND=serper)
# SERPER_API_KEY=

# SerpApi — 多引擎 SERP (SEARCH_BACKEND=serpapi)
# SERPAPI_API_KEY=
# SERPAPI_ENGINE=google

# Bing Web Search v7 (SEARCH_BACKEND=bing)
# BING_SEARCH_V7_SUBSCRIPTION_KEY=
# BING_SEARCH_V7_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Tavily AI Search (SEARCH_BACKEND=tavily)
# TAVILY_API_KEY=

# 博查中文搜索 (SEARCH_BACKEND=bocha)
# BOCHA_API_KEY=

# Google Programmable Search (SEARCH_BACKEND=google_pse) https://console.cloud.google.com/apis/dashboard?project=gen-lang-client-0860973626
# GOOGLE_PSE_API_KEY=你的 Custom Search API 密钥
# GOOGLE_PSE_ENGINE_ID=从 programmablesearchengine.google.com 复制的搜索引擎ID
# GOOGLE_PSE_REFERER= 一般不需要

# Perplexity Search (SEARCH_BACKEND=perplexity)
# PERPLEXITY_API_KEY=
# PERPLEXITY_SEARCH_API_URL=https://api.perplexity.ai/search

# Kagi (SEARCH_BACKEND=kagi)
# KAGI_SEARCH_API_KEY=

# Jina Search (SEARCH_BACKEND=jina)
# JINA_API_KEY=
# JINA_SEARCH_BASE_URL=https://s.jina.ai/

# Mojeek (SEARCH_BACKEND=mojeek)
# MOJEEK_SEARCH_API_KEY=

# Exa MCP 免 Key 搜索 (SEARCH_BACKEND=exa-mcp 时使用)
# npm install -g mcporter
# mcporter config add exa https://mcp.exa.ai/mcp
# MCPORTER_BIN=mcporter

# Camofox REST (crawler 升级链 crawl4ai → camofox → cloak)
# 生成密钥: openssl rand -hex 32
# Docker 启动: make docker-up-crawler（容器与 Python 共用此 key）
# CAMOFOX_BASE_URL=http://127.0.0.1:9377
# CAMOFOX_USER_ID=vestige
# CAMOFOX_API_KEY=
# CAMOFOX_TIMEOUT_SEC=45
# CAMOFOX_VERSION=latest
# CAMOFOX_PORT=9377

# CloakBrowser（Vestige 自有目录 scripts/cloak/）
# cd scripts/cloak && npm install
# CLOAK_SCRIPT=scripts/cloak/cloak-fetch.mjs
# CLOAK_TIMEOUT_SEC=60

# SearXNG Docker 端口绑定（make docker-up 时生效，仅本机）
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080
